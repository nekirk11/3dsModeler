-- 3dsModeler standalone launcher for 3ds Max 2025 (experimental).
-- Save this single file locally and run Scripting > Run Script...
-- It needs no sibling Python file and no current-directory assumptions.
-- The base64 block is a fixed Python clone bootstrap; see
-- tools/max_pull_and_load.py for the readable source and generator.
(
    local launcher_version = 1;
    local package_name = "max2025_menu_prototype";
    local repo_url = "https://github.com/nekirk11/3dsModeler.git";
    local branch_name = "dev";
    local checkout_path = "C:\\dev\\3dsModeler";
-- BEGIN EMBEDDED PYTHON
    local embedded_python = "";
-- END EMBEDDED PYTHON
    python.execute ("import base64; exec(compile(base64.b64decode('" + embedded_python + "'), '<3dsModeler-embedded>', 'exec'), {'__name__': '__main__'})");
)
